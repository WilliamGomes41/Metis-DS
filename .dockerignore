# Allow only code, declared dependencies and the one existing static audit file.
# Runtime state, private sources and local credentials never enter build context.
**
!Dockerfile.docling
!requirements-docling.txt
!requirements-docling.lock
!requirements-console.txt
!src/
!src/**
!scripts/
!scripts/**
!config/
!config/**
!schemas/
!schemas/**
!assets/
!assets/**
!db/
!db/**
!data/
!data/audit/
!data/audit/semantic_passage_safety_v1.json
!tests/
!tests/**
**/__pycache__
**/*.pyc
