# Acceptance image only; no infrastructure deployment or B1 fitness claim.
# Native model dependencies remain isolated from the lean console environment.
FROM python:3.12-slim
WORKDIR /app
COPY requirements-docling.txt /app/
RUN python -m venv /opt/docling \
 && /opt/docling/bin/pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && /opt/docling/bin/pip install --no-cache-dir -r requirements-docling.txt
COPY scripts/prepare_docling_models.py /app/scripts/
RUN /opt/docling/bin/python scripts/prepare_docling_models.py /opt/docling-models \
 && /opt/docling/bin/pip freeze > /opt/docling-models/python-dependencies.txt
COPY requirements-console.txt /app/
RUN pip install --no-cache-dir -r requirements-console.txt pytest httpx
COPY . /app
ENV METIS_DOCLING_PYTHON=/opt/docling/bin/python \
    METIS_DOCLING_ARTIFACTS_PATH=/opt/docling-models \
    METIS_PDF_EXTRACTOR=docling HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
CMD ["python", "-m", "pytest", "-q", "tests/test_docling_real_pdf.py"]
