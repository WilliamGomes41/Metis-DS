# Same Metis kernel and existing startup/authority guards, with an isolated
# official Docling interpreter. This recipe does not create Azure resources.
FROM python:3.12-slim AS runtime
WORKDIR /app
ARG METIS_BUILD_COMMIT=unknown
ENV METIS_BUILD_COMMIT=${METIS_BUILD_COMMIT}
RUN apt-get update \
 && apt-get install -y --no-install-recommends fonts-urw-base35 \
 && rm -rf /var/lib/apt/lists/*
COPY requirements-docling.txt requirements-docling.lock requirements-console.txt /app/
RUN python -m venv /opt/docling \
 && /opt/docling/bin/pip install --no-cache-dir torch==2.14.1+cpu torchvision==0.29.1+cpu --index-url https://download.pytorch.org/whl/cpu \
 && /opt/docling/bin/pip install --no-cache-dir -r requirements-docling.lock \
 && /opt/docling/bin/pip check \
 && python -m pip install --no-cache-dir -r requirements-console.txt
# View check (#807): the same pinned Playwright as CI with its headless Chromium,
# installed at build time; runtime never downloads. npm is removed afterwards.
# Chromium's font packages are skipped: the Docling render-font inventory
# (src/vorming/docling_render_fonts_v1.py) MUST stay identical, so the build fails if
# any file under its font roots changes.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN fonts() { find /usr/share/fonts /usr/local/share/fonts /usr/share/texmf/fonts /usr/X11R6/lib/X11/fonts \
      -type f 2>/dev/null | sort | xargs -r sha256sum | sha256sum; } \
 && before="$(fonts)" \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs npm \
 && npm install --prefix /opt/metis-browser --no-audit --no-fund playwright@1.58.2 \
 && deps="$(node /opt/metis-browser/node_modules/playwright/cli.js install-deps --dry-run chromium-headless-shell \
      | sed -n 's/.*--no-install-recommends //p' | tr -d '"' | tr ' ' '\n' \
      | grep -v -E '^(fonts-.*|xfonts-.*|xvfb)$' | tr '\n' ' ')" \
 && test -n "$deps" \
 && apt-get install -y --no-install-recommends $deps \
 && node /opt/metis-browser/node_modules/playwright/cli.js install --only-shell chromium \
 && ln -s "$(find /opt/ms-playwright -path '*chrome-headless-shell-linux64/chrome-headless-shell' -type f)" /opt/metis-browser/chrome-headless-shell \
 && test -x /opt/metis-browser/chrome-headless-shell \
 && apt-get purge -y npm && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* /root/.npm \
 && test "$before" = "$(fonts)" \
 && node -e "const {chromium}=require('/opt/metis-browser/node_modules/playwright');chromium.launch({executablePath:'/opt/metis-browser/chrome-headless-shell'}).then(b=>{console.log('view-check browser', b.version());return b.close();})"
ENV METIS_PLAYWRIGHT_MODULE=/opt/metis-browser/node_modules/playwright \
    METIS_BROWSER_EXECUTABLE=/opt/metis-browser/chrome-headless-shell
COPY scripts/prepare_docling_models.py /app/scripts/
COPY src/__init__.py /app/src/__init__.py
COPY src/vorming/__init__.py src/vorming/docling_contract_v1.py src/vorming/docling_render_fonts_v1.py /app/src/vorming/
RUN /opt/docling/bin/python scripts/prepare_docling_models.py /opt/docling-models
COPY src /app/src
COPY scripts /app/scripts
COPY config /app/config
COPY schemas /app/schemas
COPY assets /app/assets
COPY db /app/db
COPY data/audit/semantic_passage_safety_v1.json /app/data/audit/semantic_passage_safety_v1.json
ENV METIS_DOCLING_PYTHON=/opt/docling/bin/python \
    METIS_DOCLING_ARTIFACTS_PATH=/opt/docling-models \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    METIS_DOCLING_MAX_RSS_MIB=1536
# METIS_PDF_EXTRACTOR remains an explicit staged server cutover setting.
# Existing PostgreSQL/Azure Blob environment requirements still apply.
CMD ["bash", "scripts/azure_console_startup.sh"]

FROM runtime AS acceptance
RUN python -m pip install --no-cache-dir pytest httpx
COPY tests /app/tests
ENV METIS_DOCLING_REAL_ACCEPTANCE=1 METIS_PDF_EXTRACTOR=docling
CMD ["python", "-m", "pytest", "-q", "tests/test_docling_real_pdf.py"]
