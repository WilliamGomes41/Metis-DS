// Run in metis-log-analytics > Logs. phase_started records are capped per request.
// phase_elapsed_ms in a heartbeat is the current innermost active phase.
AppServiceConsoleLogs
| where TimeGenerated > ago(1h)
| where _ResourceId endswith "/sites/vvn-metis-console"
| where ResultDescription startswith "metis_diagnostic "
| extend d = parse_json(substring(ResultDescription, strlen("metis_diagnostic ")))
| where isnotempty(d.request_id)
| extend RequestId=tostring(d.request_id), Event=tostring(d.event)
| summarize arg_max(TimeGenerated, *) by RequestId
| project TimeGenerated, RequestId, Event, Route=tostring(d.route),
    Phase=tostring(d.phase), ElapsedMs=todouble(d.elapsed_ms),
    PhaseMs=todouble(d.phase_elapsed_ms), Status=toint(d.status),
    Outcome=tostring(d.outcome), Version=tostring(d.version),
    Instance=tostring(d.instance), Phases=d.phases
| order by TimeGenerated desc
