// Run in vvn-metis-console-insights > Logs.
// Includes heartbeat/start records even when the root request has not finished.
traces
| where timestamp > ago(1h)
| where customDimensions.event in ("request_started", "request_running", "request_finished")
| extend d=parse_json(message)
| project timestamp, operation_Id, RequestId=tostring(customDimensions.request_id),
    Event=tostring(customDimensions.event), Route=tostring(d.route),
    Phase=tostring(d.phase), ElapsedMs=todouble(d.elapsed_ms),
    Outcome=tostring(d.outcome), Version=tostring(d.version), Phases=d.phases
| order by timestamp desc
