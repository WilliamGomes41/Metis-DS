// Existing AppService console destination. Set the probe's attempt_id and window.
// Export the projected d objects as a JSON array or JSONL, not a portal table wrapper.
let AttemptId = "REPLACE_WITH_32_HEX_ATTEMPT_ID";
AppServiceConsoleLogs
| where TimeGenerated > ago(1h)
| where ResultDescription startswith "metis_diagnostic "
| extend d = parse_json(substring(ResultDescription, strlen("metis_diagnostic ")))
| where tostring(d.attempt_id) == AttemptId
| project d
// Alternative existing Application Insights destination:
// traces
// | where timestamp > ago(1h)
// | extend d = parse_json(message)
// | where tostring(d.attempt_id) == AttemptId
// | project d
// If a response request ID is available, query d.request_id as well. Older
// runtimes may not emit attempt_id. A zero-row query is missing evidence, not
// proof of non-arrival. Check the right resource, runtime, window and ingestion.
