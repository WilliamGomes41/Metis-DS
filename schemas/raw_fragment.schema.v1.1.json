{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venvn.nl/schemas/raw_fragment.schema.v1.1.json",
  "title": "V&VN Raw Source Fragment v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fragment_id",
    "document_id",
    "source_id",
    "source_page",
    "bbox",
    "source_locator",
    "raw_text",
    "clean_text",
    "section_path",
    "heading",
    "sequence",
    "parser_version",
    "fragment_hash"
  ],
  "properties": {
    "fragment_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_page": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "bbox": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "raw_text": {
      "type": "string"
    },
    "clean_text": {
      "type": "string"
    },
    "section_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heading": {
      "type": [
        "string",
        "null"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "parser_version": {
      "type": "string"
    },
    "fragment_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_type",
        "locator_value"
      ],
      "properties": {
        "locator_type": {
          "type": "string",
          "enum": [
            "page_bbox",
            "web_line_range",
            "css_selector",
            "json_path"
          ]
        },
        "locator_value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
